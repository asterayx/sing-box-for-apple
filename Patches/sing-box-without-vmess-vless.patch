diff --git a/protocol/tuic/quic_low_memory.go b/protocol/tuic/quic_low_memory.go
new file mode 100644
index 0000000..3842af5
--- /dev/null
+++ b/protocol/tuic/quic_low_memory.go
@@ -0,0 +1,33 @@
+//go:build with_low_memory
+
+package tuic
+
+import (
+	"time"
+
+	qtls "github.com/sagernet/sing-quic"
+)
+
+const (
+	lowMemoryStreamReceiveWindow     = 1 << 20
+	lowMemoryConnectionReceiveWindow = 4 << 20
+	lowMemoryMaxConcurrentStreams    = 32
+	lowMemoryIdleTimeout             = 30 * time.Second
+)
+
+// applyLowMemoryQUICOptions supplies conservative defaults for memory-limited
+// Apple Network Extensions. Explicit profile values always take precedence.
+func applyLowMemoryQUICOptions(options *qtls.QUICOptions) {
+	if options.StreamReceiveWindow == 0 {
+		options.StreamReceiveWindow = lowMemoryStreamReceiveWindow
+	}
+	if options.ConnectionReceiveWindow == 0 {
+		options.ConnectionReceiveWindow = lowMemoryConnectionReceiveWindow
+	}
+	if options.MaxConcurrentStreams == 0 {
+		options.MaxConcurrentStreams = lowMemoryMaxConcurrentStreams
+	}
+	if options.IdleTimeout == 0 {
+		options.IdleTimeout = lowMemoryIdleTimeout
+	}
+}
