index f73ab28..144c4e3 100644
--- a/service/oomkiller/timer_darwin.go
+++ b/service/oomkiller/timer_darwin.go
@@ -2,14 +2,31 @@
 
 package oomkiller
 
-import runtimeDebug "runtime/debug"
+import (
+	runtimeDebug "runtime/debug"
+
+	"github.com/sagernet/sing/common/byteformats"
+)
 
 func (t *adaptiveTimer) notifyPressure() {
 	runtimeDebug.FreeOSMemory()
+	sample := readMemorySample(t.policyMode)
 	t.access.Lock()
 	t.startLocked()
+	shouldTrigger := t.state != pressureStateTriggered
+	t.state = pressureStateTriggered
 	t.forceMinInterval = true
 	t.pendingPressureBaseline = true
 	t.access.Unlock()
+	if shouldTrigger {
+		if t.killerDisabled {
+			t.logger.Warn("memory pressure critical (report only), usage: ", byteformats.FormatMemoryBytes(sample.usage), t.logDetails(sample))
+		} else {
+			t.logger.Error("memory pressure critical, usage: ", byteformats.FormatMemoryBytes(sample.usage), t.logDetails(sample), ", resetting network immediately")
+			t.network.ResetNetwork()
+		}
+		badCleanup()
+		runtimeDebug.FreeOSMemory()
+	}
 	t.poll()
 }
