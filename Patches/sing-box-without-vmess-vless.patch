diff --git a/include/openvpn_openconnect_naive_removed_test.go b/include/openvpn_openconnect_naive_removed_test.go
new file mode 100644
index 0000000..011d57e
--- /dev/null
+++ b/include/openvpn_openconnect_naive_removed_test.go
@@ -0,0 +1,28 @@
+//go:build without_openvpn_openconnect_naive
+
+package include
+
+import (
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func TestOpenVPNOpenConnectNaiveAreNotRegistered(t *testing.T) {
+	if _, loaded := InboundRegistry().CreateOptions(C.TypeNaive); loaded {
+		t.Error("naive inbound is registered")
+	}
+	if _, loaded := OutboundRegistry().CreateOptions(C.TypeNaive); loaded {
+		t.Error("naive outbound is registered")
+	}
+	for _, endpointType := range []string{C.TypeOpenVPNClient, C.TypeOpenVPNServer, C.TypeOpenConnect} {
+		if _, loaded := EndpointRegistry().CreateOptions(endpointType); loaded {
+			t.Errorf("endpoint %q is registered", endpointType)
+		}
+	}
+	for _, dnsType := range []string{C.DNSTypeOpenVPN, C.DNSTypeOpenConnect} {
+		if _, loaded := DNSTransportRegistry().CreateOptions(dnsType); loaded {
+			t.Errorf("DNS transport %q is registered", dnsType)
+		}
+	}
+}
